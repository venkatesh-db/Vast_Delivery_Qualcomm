# Copy to config.env before running.

# New disposable directory only. For a VAST lab, place this beneath the mounted
# training View. Never select a real dataset or production directory.
LAB_DIR=/var/tmp/vast-ai-training-lab
CONFIRM_DISPOSABLE_LAB=YES

# Small defaults keep a classroom run short. Increase both to 1G or 4G when the
# training VM and lab storage have sufficient capacity.
DATASET_SIZE=128M
CONTENTION_FILE_SIZE=128M

# Workload model. The small baseline delay represents normal loader overhead.
# The degraded delay represents increased data-delivery wait. Together with the
# compute interval these produce the intended ~95% to ~45% teaching signal.
BATCH_COUNT=80
BATCH_BYTES=1048576
COMPUTE_MS=40
BASELINE_LOADER_DELAY_MS=2
DEGRADED_LOADER_DELAY_MS=46
BASELINE_TRAINING_HOURS=3

# Real competing small-block workload. It writes only to contention.bin.
COMPETITOR_BS=4k
COMPETITOR_IODEPTH=32
COMPETITOR_JOBS=2
FIO_DIRECT=1

# Set to 0 only if the lab filesystem does not support direct I/O.
DROP_FILE_CACHE_HINT=1
