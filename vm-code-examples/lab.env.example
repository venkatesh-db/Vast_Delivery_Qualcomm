# Copy this file to lab.env and edit for the training VM.

# Approved, disposable test directory. Do not use /, /home, or a real dataset.
TARGET_DIR=/var/tmp/vast-training-target
ALLOW_WRITE_TESTS=NO
KEEP_TEST_DATA=NO

# Protocol checks. Leave unused values empty.
NFS_TEST_PATH=
SMB_SERVER=
SMB_SHARE=
SMB_AUTH_FILE=
S3_OBJECT=
MINIO_HEALTH_URL=

# Packet-capture and controlled network lab.
LAB_IF=
TARGET_HOST=
BPF_FILTER=

# Required only for controlled fault-injection demonstrations.
CONFIRM_CONTROLLED_LAB=NO
ALLOW_DEFAULT_ROUTE_NETEM=NO

# Optional tuning.
DURATION=30
FIO_SIZE=1G
ARTIFACT_DIR=

