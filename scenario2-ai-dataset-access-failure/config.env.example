# Copy to config.env before running.

# New disposable directory only. For VAST, use a new subdirectory beneath a
# mounted training View. Never use a production dataset.
LAB_DIR=/var/tmp/vast-ai-dataset-access-lab
CONFIRM_DISPOSABLE_LAB=YES

SHARD_SIZE_BYTES=1048576
INITIAL_METADATA_FILES=100
METADATA_FILE_BYTES=4096
GROWTH_FILES_PER_CYCLE=50

BASELINE_DURATION_SECONDS=2
INCIDENT_DURATION_SECONDS=5
RECOVERY_DURATION_SECONDS=2
CLIENT_READ_INTERVAL_MS=20

# The legacy shard is absent during this window on every publisher cycle.
PUBLISH_INTERVAL_MS=100
LEGACY_DELETE_GAP_MS=60

# Scenario identity labels. These are evidence labels, not Linux accounts.
CURRENT_CLIENT_NAME=trainer-b
CURRENT_CLIENT_UID=2002
STALE_CLIENT_NAME=trainer-a
STALE_CLIENT_UID=2001
